#!/bin/sh
# Entry point of the AppImage.
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="${APPDIR:-$HERE}"
# the build publishes with InvariantGlobalization; this keeps a stray libicu from being probed
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
exec "$HERE/usr/lib/FatihKalem/FatihKalem" "$@"
